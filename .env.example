# Variáveis de Ambiente Globais para o site-cdc (Docker / Hostinger)

# Banco de Dados PostgreSQL
DB_HOST=postgres
DB_USER=cdc_user
DB_NAME=site_cdc_db
DB_PASSWORD=<SUA_SENHA_FORTE_AQUI>

# Backend Express API
NODE_ENV=production
EMAIL_FROM=contato@ongcdc.org.br
EMAIL_PASSWORD=<SENHA_SMTP_EMAIL>

# Painel Administrativo AdminJS
ADMIN_EMAIL=admin@ongcdc.org.br
ADMIN_PASSWORD=<SENHA_ADMIN_PAINEL>
COOKIE_SECRET=<CHAVE_ALEATORIA_COOKIE_SECRET>
GOOGLE_CLIENT_ID=<SEU_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<SEU_GOOGLE_CLIENT_SECRET>
BASE_URL=https://admin.ongcdc.org.br

# Frontend Next.js
NEXT_PUBLIC_API_URL=https://api.ongcdc.org.br
NEXT_PUBLIC_STORAGE=https://api.ongcdc.org.br/uploads
